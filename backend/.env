# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=portfolio_cms
DB_USER=root
DB_PASSWORD=password

# Auth
JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_ACCESS_EXPIRES=15m

JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_REFRESH_EXPIRES_DAYS=30

# Signs the short-lived token used between "password verified" and
# "OTP verified" during admin login. Must be a different secret from the
# access/refresh ones above.
JWT_OTP_SECRET=change_this_to_a_third_long_random_string

# Bootstrap admin (used only by `npm run seed`)
ADMIN_NAME=Vishal Mall
ADMIN_EMAIL=vishal.mall02@outlook.com
ADMIN_PASSWORD=password

# --- Email (SMTP) ------------------------------------------------------
# Used for: (1) admin login OTP codes, (2) contact-form notification email.
# Leave SMTP_HOST unset to disable sending (emails are skipped with a
# console warning; everything else — DB notifications, OTP records — still
# works, which is convenient for local dev without a mail server).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=vmall4237@gmail.com
SMTP_PASS=folqkidobrqilpfn
SMTP_FROM="Portfolio Admin" <vmall4237@gmail.com>

# Contact-form notification emails are always sent to this address,
# regardless of who is logged in as admin.
ADMIN_NOTIFY_EMAIL=vishal.mall02@outlook.com

# --- OTP (admin login 2nd factor) --------------------------------------
OTP_EXPIRES_MIN=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=30

# --- Cloudinary (Gallery module image uploads only) ---------------------
# Every other module keeps using local disk storage under /uploads —
# Cloudinary is scoped to the Gallery module as requested.
CLOUDINARY_CLOUD_NAME=x8pzhupk
CLOUDINARY_API_KEY=388774711897513
CLOUDINARY_API_SECRET=5uN49EKVPfjtqEuW65Kowb46OtE