# API base URL for the portfolio frontend. Must match the backend's PORT
# (see backend/.env) and include the /api prefix used by all routes.
VITE_API_URL=http://localhost:5000/api

# Base URL used to resolve uploaded file paths (images, resumes, etc.)
# returned by the backend, e.g. "/uploads/projects/foo.png".
VITE_FILE_URL=http://localhost:5000
